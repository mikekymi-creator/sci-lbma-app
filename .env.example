# Public project identifiers only. Never put service-role/VAPID private keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Worker only (Supabase secret/server key or legacy service_role key).
SUPABASE_SERVICE_ROLE_KEY=
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Optional: allows a trusted scheduler to POST /api/jobs with Authorization: Bearer <secret>.
CRON_SECRET=
# Exact comma-separated HTTPS hostnames, explicitly approved for listing/feed imports.
IMPORT_ALLOWED_HOSTS=
