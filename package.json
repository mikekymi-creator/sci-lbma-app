{
  "name": "lbma-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/core.test.ts",
    "test:browser": "playwright test",
    "worker": "node --import tsx scripts/worker.ts",
    "worker:once": "node --import tsx scripts/worker.ts --once",
    "push:keys": "node --import tsx scripts/generate-push-keys.ts",
    "preview:build": "vite build --config preview/vite.config.mts",
    "preview:test": "playwright test --config playwright.preview.config.ts",
    "preview:serve": "vite preview --config preview/vite.config.mts --host 127.0.0.1 --port 4173",
    "test:connected": "playwright test --config playwright.connected.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cheerio": "^1.1.2",
    "ipaddr.js": "^2.2.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.16.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^8.3.5"
  }
}
